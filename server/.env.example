# SmartHire Server Environment Configuration
# Copy this file to .env and configure your local settings

# Server port
PORT=5000

# Node environment: development or production
NODE_ENV=development

# MongoDB Connection URI (Local default: mongodb://127.0.0.1:27017/smarthire)
MONGODB_URI=mongodb://127.0.0.1:27017/smarthire

# JWT Secret Key (Use a strong random string in production)
JWT_SECRET=smarthire_super_secret_jwt_key_2026_academic_demo

# JWT Token Expiry (e.g., 7d, 24h, 1h)
JWT_EXPIRES_IN=7d

# Allowed Client Origin for CORS and Cookies
CLIENT_URL=http://localhost:5173

# Admin Seeding Credentials (Used exclusively by scripts/createAdmin.js)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@smarthire.local
ADMIN_PASSWORD=Admin@12345
